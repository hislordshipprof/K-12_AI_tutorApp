# ─── Copy this to .env (and apps/web/.env.local, apps/api/.env) ───
# NEVER commit .env files.

# Gemini API (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Models (latest as of April 2026)
GEMINI_MODEL_TEXT=gemini-3.1-flash
GEMINI_MODEL_VISION=gemini-3.1-flash
GEMINI_MODEL_LIVE=gemini-3.1-flash-live-preview
GEMINI_MODEL_PRO=gemini-3.1-pro
GEMINI_MODEL_EMBED=gemini-embedding-001

# Supabase (fill in from your Supabase project settings)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your_jwt_secret

# Public (safe to expose to browser — Next.js NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_API_BASE=http://localhost:8000

# API config
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=INFO
