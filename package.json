{
  "name": "k12-ai-tutor",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"pnpm web:dev\" \"pnpm api:dev\"",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm -F @edumind/web test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "api:dev": "cd apps/api && (test -d .venv || python3 -m venv .venv) && .venv/bin/pip install -e . -q && DEV_MODE=true .venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "api:test": "cd apps/api && .venv/bin/pytest -q",
    "web:dev": "cd apps/web && pnpm dev",
    "verify": "bash scripts/verify-all.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
